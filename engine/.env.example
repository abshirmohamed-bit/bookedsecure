# --- required ---
ENGINE_API_KEYS=change-me-to-a-long-random-string
WEBHOOK_URL=https://bookedsecure.com/api/public/hooks/engine
WEBHOOK_SECRET=change-me-too
# The Engine refuses to start on the placeholders above. Local development only:
# ALLOW_DEV_SECRETS=1

# --- storage ---
# local: files under DATA_DIR/media, served by this service.
# s3:    any S3-compatible bucket (Cloudflare R2, AWS, MinIO).
STORAGE_BACKEND=local
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8080
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=crayzmundo
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=https://media.yourdomain.com

# --- transcription ---
# faster-whisper downloads its model on first run. fake = deterministic, for tests.
TRANSCRIBE_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# --- moment finding ---
# ai = real judgement (needs a key). rules = transcript heuristics, no key, no cost.
FINDER_PROVIDER=ai
#
# One key is normally the whole setup: the provider and a sensible model are
# read from the key's shape.
#   ci_live_... Cheaper Inference (gpt-5.6-luna)
#   gsk_...     Groq          (openai/gpt-oss-20b)
#   sk-ant-...  Anthropic     (claude-sonnet-4-5)
#   sk-or-...   OpenRouter    (openai/gpt-4o-mini)
#   sk-...      OpenAI        (gpt-4o-mini)
AI_API_KEY=
# Only for a provider not in that list, or to point at a gateway of your own.
# Give the base that has /chat/completions under it.
AI_BASE_URL=
# Only to override the default model for that provider.
AI_MODEL=
#
# The original Anthropic-only settings still work and are used if AI_API_KEY is empty.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# --- limits ---
MAX_UPLOAD_BYTES=4294967296
MIN_SOURCE_SECONDS=10
MAX_SOURCE_SECONDS=10800
CONCURRENT_JOBS=3
CONCURRENT_RENDERS=4
RETENTION_DAYS=30

# Optional storage quota in bytes; 0 means no quota.
STORAGE_LIMIT_BYTES=0

# --- Fly.io / Tigris (set automatically by `fly storage create`) ---
# BUCKET_NAME=
# AWS_ENDPOINT_URL_S3=https://t3.storage.dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://your-bucket.t3.tigrisfiles.io

# Seconds to let an in-flight render finish on shutdown. Keep below fly.toml's kill_timeout.
SHUTDOWN_GRACE_S=120

# Stop the machine after this many quiet seconds so a host that bills by the
# second only bills for the hours actually used. It never stops with a job,
# import, export or undelivered webhook outstanding. 0 = run around the clock,
# which is what you want locally. fly.toml sets 600 in production.
IDLE_SHUTDOWN_S=0

# Residential proxy for the handful of videos YouTube refuses to serve a
# cloud machine. Used ONLY after every player client has been refused on this
# machine's own address, because it is billed by the gigabyte and a video is
# most of one. Leave unset and those videos simply fail with a clear message.
# YTDLP_PROXY=http://user:pass@host:port
# Set to 1 to stop trying direct first — only worth it if everything is being
# refused, when going direct is just a slow way to fail.
# YTDLP_PROXY_ALWAYS=0
