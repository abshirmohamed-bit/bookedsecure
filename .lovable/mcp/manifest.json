      {
        "name": "query_leads",
        "title": "Filter the lead inbox",
        "description": "Reuse the same paginated inbox query as Cowork and BookedSecure. Filter by status, source, text-delivery state or customer search. Returns exact counts and a bounded page; follow next_page for all matches.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "new",
                "previous_lead",
                "contacted",
                "waiting_for_customer",
                "customer_replied",
                "ready_for_quote",
                "quote_sent",
                "scheduled",
                "completed",
                "lost",
                "opted_out",
                "invalid",
                "all"
              ],
              "default": "all"
            },
            "source": {
              "type": "string",
              "enum": [
                "meta",
                "godaddy",
                "website",
                "hosted_page",
                "manual",
                "unknown",
                "all"
              ],
              "default": "all"
            },
            "sms": {
              "type": "string",
              "enum": [
                "all",
                "sms_delivered",
                "sms_pending",
                "sms_failed",
                "sms_undelivered",
                "sms_suppressed",
                "no_reply_after_delivery"
              ],
              "default": "all"
            },
            "search": {
              "type": "string",
              "maxLength": 120,
              "default": ""
            },
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
